VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login credentials, as SHA-256 hex hashes (NOT the VITE_ prefix -
# these must stay server-only or they'd ship inside the client bundle).
# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('yourValue').digest('hex'))"
ADMIN_USER_HASH=
ADMIN_PASS_HASH=
# Secret used to sign admin session tokens issued by /api/admin/login.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# Cloudinary (client-side)
VITE_CLOUDINARY_CLOUD_NAME=

# Cloudinary (server-side for Vercel API functions)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
